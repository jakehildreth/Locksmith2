              </ListItem>
              <ListItem>
                <Label>Role</Label>
                <PropertyName>ActiveDirectoryRights</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Issue</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <!-- Full view: every LS2Issue property including remediation scripts -->
    <View>
      <Name>Full</Name>
      <ViewSelectedBy>
        <TypeName>LS2Issue</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
